* {
  box-sizing: border-box;
}

:root {
  --navy: #172b4d;
  --blue: #315fc7;
  --blue-dark: #244da8;
  --text: #26364d;
  --muted: #7d899b;
  --border: #dfe5ee;
  --background: #f3f6fb;
}

body {
  margin: 0;
  min-height: 100vh;
  background: var(--background);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
}

.topbar {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 20px max(6%, calc((100% - 1120px) / 2));
  background: #ffffff;
  border-bottom: 1px solid #e8edf4;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 46px;
  height: 46px;
  border-radius: 13px;
  background: var(--blue);
  color: #ffffff;
  font-size: 15px;
  font-weight: 800;
}

.topbar h1 {
  margin: 0 0 4px;
  color: var(--navy);
  font-size: 19px;
}

.topbar p {
  margin: 0;
  color: var(--muted);
  font-size: 12px;
}

.page {
  width: min(920px, 90%);
  margin: 52px auto 28px;
}

.intro {
  margin-bottom: 24px;
}

.eyebrow {
  margin: 0 0 10px;
  color: var(--blue);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.intro h2 {
  margin: 0 0 9px;
  color: var(--navy);
  font-size: clamp(27px, 4vw, 35px);
}

.description {
  margin: 0;
  color: var(--muted);
  font-size: 15px;
  line-height: 1.6;
}

.card {
  padding: 34px;
  background: #ffffff;
  border: 1px solid #e8edf4;
  border-radius: 17px;
  box-shadow: 0 12px 35px rgba(23, 43, 77, 0.07);
}

.card-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 30px;
}

.card-heading h3 {
  margin: 0 0 7px;
  color: var(--navy);
  font-size: 20px;
}

.card-heading p {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
}

.step {
  padding: 8px 11px;
  border-radius: 20px;
  background: #edf3ff;
  color: var(--blue);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1px;
}

.required {
  color: #d84b59;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 23px 20px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

label {
  color: #34445c;
  font-size: 13px;
  font-weight: 700;
}

input,
select {
  width: 100%;
  min-height: 49px;
  padding: 0 14px;
  border: 1px solid var(--border);
  border-radius: 9px;
  outline: none;
  background: #ffffff;
  color: var(--text);
  font: inherit;
  font-size: 14px;
}

input::placeholder {
  color: #a1aaba;
}

input:focus,
select:focus {
  border-color: var(--blue);
  box-shadow: 0 0 0 3px rgba(49, 95, 199, 0.12);
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 34px;
}

button {
  min-height: 48px;
  padding: 0 21px;
  border: 0;
  border-radius: 9px;
  cursor: pointer;
  font-size: 14px;
  font-weight: 700;
}

.submit-btn {
  background: var(--blue);
  color: #ffffff;
}

.submit-btn:hover {
  background: var(--blue-dark);
}

.clear-btn {
  background: #eef1f6;
  color: #536176;
}

.form-message {
  min-height: 18px;
  margin: 16px 0 0;
  font-size: 13px;
}

.form-message.success {
  color: #218653;
  font-weight: 700;
}

footer {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin-top: 24px;
  color: var(--muted);
  font-size: 12px;
}

footer p {
  margin: 0;
}

footer strong {
  color: var(--navy);
}

@media (max-width: 620px) {
  .page {
    margin-top: 34px;
  }

  .card {
    padding: 23px 19px;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .card-heading {
    flex-direction: column;
  }

  footer {
    flex-direction: column;
  }
}
